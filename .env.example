# Which provider the demo and evals use: mock (no key), anthropic, or openai
INTENTFLOW_PROVIDER=mock

# Claude (https://console.anthropic.com). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
# INTENTFLOW_ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (https://platform.openai.com). Default model: gpt-6-astra (alternatives: gpt-6.1-sol, gpt-6-luna)
OPENAI_API_KEY=
# INTENTFLOW_OPENAI_MODEL=gpt-6-astra
