{
  "name": "@codesxlab/intentflow",
  "version": "0.2.0",
  "description": "Turn messages into reviewed, structured actions with any LLM. Model-agnostic, schema-validated, human-in-the-loop.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "tsx demo/server.ts",
    "eval": "tsx evals/run.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "site": "tsx demo/build-site.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesxlab/intentflow.git"
  },
  "keywords": [
    "llm",
    "structured-outputs",
    "human-in-the-loop",
    "workflow-automation",
    "claude",
    "openai",
    "zod"
  ],
  "author": "CodesXlab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codesxlab/intentflow/issues"
  },
  "homepage": "https://github.com/codesxlab/intentflow#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.43.0"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
